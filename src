import java.util.ArrayList;
import java.util.Scanner;

public class U07aPizzaToppingsApp {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        // Step 1
        ArrayList<String> myList = new ArrayList<>();
        myList.add("Pepperoni");
        myList.add("Mushroom");
        myList.add("Sausage");
        myList.add("Onion");
        myList.add("Black Olives");

        // Step 2
        System.out.println("Displaying the list using the toString method...");
        System.out.println(myList);
        
        // Step 3
        System.out.print("\nGimme a new pizza topping to add to the list: ");
        String userString = input.nextLine();

        // Step 4 (check if already exists)
        boolean found = false;
        for (String topping : myList) {
            if (topping.equalsIgnoreCase(userString)) {
                found = true;
            }
        }

        // Step 5
        if (!found) {
            myList.add(2, userString);
            System.out.println("Using the add method to add " + userString + " at index 2.");
            System.out.println("All values are shifted and " + userString + " is inserted at index 2.");
            System.out.println("The new list is displayed using the toString method...");
            System.out.println(myList);
        } else {
            System.out.println("That topping is already in the list.");
        }

        // Step 6
        String removeItem = "";

        while (true) {
            System.out.print("\nGimme a pizza topping to remove from the list or type Q to quit: ");
            removeItem = input.nextLine();

            if (removeItem.equalsIgnoreCase("q")) {
                break;
            }

            boolean removed = false;

            // IMPORTANT: do NOT remove inside for-each
            for (int i = 0; i < myList.size(); i++) {
                if (myList.get(i).equalsIgnoreCase(removeItem)) {
                    myList.remove(i);
                    removed = true;
                    break;
                }
            }

            if (removed) {
                System.out.println(myList);
            } else {
                System.out.println("That is not in the list");
                System.out.println(myList);
            }
        }

        // Step 7
        System.out.println("Displaying the list using the toString method...");
        System.out.println(myList);

        // Clear the list
        myList.clear();
    }
}